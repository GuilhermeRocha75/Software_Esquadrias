FROM python:3.12-slim
WORKDIR /srv/software-esquadrias
ENV PYTHONUNBUFFERED=1 PORT=8000
COPY api/requirements.txt api/requirements.txt
RUN python -m pip install --no-cache-dir -r api/requirements.txt
COPY api api
COPY engine engine
EXPOSE 8000
CMD ["sh", "-c", "exec python -m uvicorn api.app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*' --access-log"]
