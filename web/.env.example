# Padrão: mesma origem. Vite encaminha /api e /health para a API local;
# em produção o servidor do domínio deve encaminhar essas rotas para o backend.
VITE_API_URL=
# Somente para backend em outro domínio: informar aqui a URL pública HTTPS
# e autorizar a origem do frontend em CORS_ALLOWED_ORIGINS na API.
# Este valor é aplicado no build; exige reconstruir e publicar o frontend.
